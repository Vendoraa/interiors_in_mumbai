{
  "name": "visva",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@contentful/rich-text-react-renderer": "^16.1.6",
    "@contentful/rich-text-types": "^17.2.5",
    "@emailjs/browser": "^4.4.1",
    "@react-spring/parallax": "^9.7.2",
    "@react-spring/web": "^9.7.2",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "bootstrap": "^5.2.3",
    "contentful": "^10.12.0",
    "framer-motion": "^10.12.12",
    "html2pdf.js": "^0.10.3",
    "lightgallery": "^2.7.1",
    "react": "^18.2.0",
    "react-bootstrap": "^2.7.4",
    "react-countup": "^6.4.2",
    "react-dom": "^18.2.0",
    "react-google-recaptcha": "^2.1.0",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.43.9",
    "react-modal-image": "^2.6.0",
    "react-modal-video": "^2.0.0",
    "react-parallax": "^3.5.1",
    "react-responsive-masonry": "^2.1.7",
    "react-router-dom": "^6.11.1",
    "react-scripts": "5.0.1",
    "react-swiper": "^0.1.5",
    "reactjs-popup": "^2.0.5",
    "sass": "^1.77.0",
    "swiper": "^9.3.2",
    "vanilla-cookieconsent": "^3.1.0",
    "web-vitals": "^2.1.4",
    "yet-another-react-lightbox": "^3.8.3"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "postbuild": "node scripts/generate-sitemap.js && react-snap",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "sass": "sass --watch src/assets/scss/main.scss:src/assets/css/style.css --source-map"
  },
  "reactSnap": {
    "include": [
      "/",
      "/about-us",
      "/services",
      "/portfolio",
      "/blog",
      "/contact-us",
      "/privacy-policy",
      "/pricing",
      "/team",
      "/services-details",
      "/interior-designers-mira-road",
      "/interior-designers-andheri",
      "/interior-designers-bandra",
      "/interior-designers-powai",
      "/interior-designers-thane"
    ],
    "delay": 5000,
    "timeout": 30000,
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox",
      "--disable-dev-shm-usage",
      "--disable-accelerated-2d-canvas",
      "--no-first-run",
      "--no-zygote",
      "--single-process",
      "--disable-gpu"
    ],
    "skipThirdPartyRequests": true,
    "removeScriptTags": false,
    "removeBlobs": false
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.0",
    "react-snap": "^1.23.0",
    "sharp": "^0.35.3"
  }
}
